{
  "manifest_version": 3,
  "name": "Listening Time",
  "short_name": "Listening Time",
  "version": "1.0.0",
  "description": "Conta o tempo de tela enquanto você assiste Netflix, Prime Video, YouTube, HBO Max, Crunchyroll, Apple TV e Disney+.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Listening Time",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pausar / retomar a contagem"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.com.br/*",
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.crunchyroll.com/*",
        "*://tv.apple.com/*",
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
